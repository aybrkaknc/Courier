{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.telegram.org/*"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "__MSG_cmdSendPage__"
    },
    "send-screenshot": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "__MSG_cmdSendScreenshot__"
    },
    "send-area": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "__MSG_cmdSendArea__"
    }
  }
}
